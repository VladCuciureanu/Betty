class BettyBluetooth < Formula
  desc "Small cross-platform Bluetooth command-line interface"
  homepage "https://github.com/vladcuciureanu/betty"
  url "https://github.com/vladcuciureanu/betty/releases/download/v@@VERSION@@/betty-@@VERSION@@.tar.gz"
  sha256 "@@SHA256@@"
  license "MIT"

  depends_on "go" => :build
  depends_on xcode: :build

  def install
    system "go", "build", *std_go_args(ldflags: "-s -w -X main.version=v#{version}", output: bin/"bt"), "./cmd/bt"
  end

  test do
    assert_match "bt v#{version}", shell_output("#{bin}/bt --version")
    assert_match '"schema_version":1', shell_output("#{bin}/bt --json --timeout=invalid list 2>&1", 2)
  end
end
