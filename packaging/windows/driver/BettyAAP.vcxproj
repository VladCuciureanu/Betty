<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{56C9CA1F-E592-42E4-87D1-507AB7449A91}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>BettyAAP</RootNamespace>
    <!-- Must match the platform version of the SDK and WDK packages below. -->
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!--
    The WDK comes from NuGet, but the build agent's installed driver toolset
    resolves WDK tools against its own kit, which lacks this SDK version, so
    stampinf.exe and Inf2Cat.exe are not found. Point the tool directory at
    the NuGet WDK. WDKContentRoot has no trailing separator in NuGet builds.
  -->
  <PropertyGroup Condition="'$(WDK_NuGet)' == 'true'">
    <WDKBinRoot>$(WDKContentRoot)\bin\$(WindowsTargetPlatformVersion)</WDKBinRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <TargetVersion>Windows10</TargetVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>BettyAAP</TargetName>
    <OutDir>$(SolutionDir)artifacts\driver\</OutDir>
    <IntDir>$(SolutionDir)artifacts\obj\driver\</IntDir>
    <Inf2CatUseLocalTime>true</Inf2CatUseLocalTime>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>NDEBUG;_AMD64_;_KERNEL_MODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Inf>
      <SpecifyDriverDirectiveVersion>true</SpecifyDriverDirectiveVersion>
      <TimeStamp Condition="'$(DriverVersion)' != ''">$(DriverVersion)</TimeStamp>
      <TimeStamp Condition="'$(DriverVersion)' == ''">1.0.0.0</TimeStamp>
      <DateStamp>*</DateStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Driver.c" />
    <ClInclude Include="BettyAAP.h" />
    <Inf Include="BettyAAP.inf" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SDK and WDK packages must share one version. -->
    <PackageReference Include="Microsoft.Windows.SDK.CPP" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.CPP.x64" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.WDK.x64" Version="10.0.28000.2526" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
