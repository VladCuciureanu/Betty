[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%Betty%
DriverVer=08/21/2026,1.0.0.0
CatalogFile=BettyAAP.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
BettyAAP.sys=1,,

[Manufacturer]
%Betty%=BettyModels,NTamd64.10.0.1..16299

[BettyModels.NTamd64.10.0.1..16299]
%BettyAAP.DeviceDesc%=BettyAAP_Install,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}

[BettyAAP_Install.NT]
CopyFiles=BettyAAP_CopyFiles

[BettyAAP_CopyFiles]
BettyAAP.sys

[BettyAAP_Install.NT.HW]
AddReg=BettyAAP_Security_AddReg

; Only SYSTEM, administrators and interactive users may open the device.
; Interactive users get read/write, which the IOCTL access bits require.
; 0x100 is FILE_DEVICE_SECURE_OPEN.
[BettyAAP_Security_AddReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"
HKR,,DeviceCharacteristics,0x10001,0x100

[BettyAAP_Install.NT.Services]
AddService=BettyAAP,0x00000002,BettyAAP_Service

[BettyAAP_Service]
DisplayName=%BettyAAP.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\BettyAAP.sys

[BettyAAP_Install.NT.Wdf]
KmdfService=BettyAAP,BettyAAP_Wdf

[BettyAAP_Wdf]
KmdfLibraryVersion=1.15

[Strings]
Betty="Betty"
DiskName="Betty Apple Audio Driver Installation Media"
BettyAAP.DeviceDesc="Betty Apple Audio AAP Transport"
BettyAAP.ServiceDesc="Betty Apple Audio Bluetooth Profile Driver"
