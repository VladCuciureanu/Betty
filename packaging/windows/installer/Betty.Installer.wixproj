<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>betty-windows-x64</OutputName>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\payload</PayloadDir>
    <DriverDir Condition="'$(DriverDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\driver</DriverDir>
    <DefineConstants>Version=$(Version);PayloadDir=$(PayloadDir);DriverDir=$(DriverDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Package.Advanced.wxs" />
  </ItemGroup>
</Project>
