{
  "protocol": 1,
  "id": "official/apple-audio",
  "name": "Apple Audio",
  "version": "bundled",
  "permissions": [
    "device-metadata",
    "advertisements",
    "l2cap",
    "driver-storage"
  ],
  "match": {
    "company_ids": [
      76
    ],
    "name_contains": [
      "AirPods",
      "Beats"
    ]
  }
}
